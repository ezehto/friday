{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/schedule.schema.json",
  "title": "ScheduleWidget",
  "$comment": "draft: finalized with its pack (L14 or L16)",
  "type": "object",
  "properties": {
    "type": {
      "const": "schedule"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "day": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "start",
          "end",
          "title",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "type",
    "day",
    "items"
  ],
  "additionalProperties": false
}
