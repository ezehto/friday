{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/meeting.schema.json",
  "title": "MeetingWidget",
  "$comment": "draft: finalized with its pack (L14 or L16)",
  "type": "object",
  "properties": {
    "type": {
      "const": "meeting"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "maxItems": 12
    },
    "location": {
      "type": "string",
      "maxLength": 60
    },
    "prep_ref": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "type",
    "title",
    "start",
    "end"
  ],
  "additionalProperties": false
}
