{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/career_progress.schema.json",
  "title": "CareerProgressWidget",
  "type": "object",
  "properties": {
    "type": {
      "const": "career_progress"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "target": {
      "type": "string",
      "maxLength": 60
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "done": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "done",
          "total"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    }
  },
  "required": [
    "type",
    "target",
    "week",
    "skills"
  ],
  "additionalProperties": false
}
