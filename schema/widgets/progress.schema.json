{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/progress.schema.json",
  "title": "ProgressWidget",
  "type": "object",
  "properties": {
    "type": {
      "const": "progress"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "label": {
      "type": "string",
      "maxLength": 60
    },
    "done": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tone": {
      "$ref": "../common.schema.json#/$defs/Tone"
    }
  },
  "required": [
    "type",
    "label",
    "done",
    "total"
  ],
  "additionalProperties": false
}
