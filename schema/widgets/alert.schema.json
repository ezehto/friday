{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/alert.schema.json",
  "title": "AlertWidget",
  "type": "object",
  "properties": {
    "type": {
      "const": "alert"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "level": {
      "$ref": "../common.schema.json#/$defs/Tone"
    },
    "text": {
      "type": "string",
      "maxLength": 200
    },
    "view": {
      "type": "string",
      "enum": [
        "sessions",
        "permissions",
        "traces",
        "modules"
      ]
    }
  },
  "required": [
    "type",
    "level",
    "text"
  ],
  "additionalProperties": false
}
