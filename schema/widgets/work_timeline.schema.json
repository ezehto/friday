{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/widgets/work_timeline.schema.json",
  "title": "WorkTimelineWidget",
  "type": "object",
  "properties": {
    "type": {
      "const": "work_timeline"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "when",
          "title"
        ],
        "additionalProperties": false
      },
      "maxItems": 30
    }
  },
  "required": [
    "type",
    "items"
  ],
  "additionalProperties": false
}
