{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/blocks/kanban.schema.json",
  "title": "KanbanBlock",
  "type": "object",
  "properties": {
    "kind": {
      "const": "kanban"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 80
                },
                "meta": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          }
        },
        "required": [
          "title",
          "items"
        ],
        "additionalProperties": false
      },
      "maxItems": 6
    }
  },
  "required": [
    "kind",
    "columns"
  ],
  "additionalProperties": false
}
