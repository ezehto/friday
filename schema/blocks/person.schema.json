{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/blocks/person.schema.json",
  "title": "PersonBlock",
  "type": "object",
  "properties": {
    "kind": {
      "const": "person"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "role": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    }
  },
  "required": [
    "kind",
    "people"
  ],
  "additionalProperties": false
}
