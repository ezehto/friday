{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/blocks/alert.schema.json",
  "title": "AlertBlock",
  "type": "object",
  "properties": {
    "kind": {
      "const": "alert"
    },
    "level": {
      "$ref": "../common.schema.json#/$defs/Tone"
    },
    "text": {
      "type": "string",
      "maxLength": 200
    },
    "view": {
      "$ref": "../common.schema.json#/$defs/AlertView"
    }
  },
  "required": [
    "kind",
    "level",
    "text"
  ],
  "additionalProperties": false
}
