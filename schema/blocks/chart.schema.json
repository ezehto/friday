{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/blocks/chart.schema.json",
  "title": "ChartBlock",
  "type": "object",
  "properties": {
    "kind": {
      "const": "chart"
    },
    "chart": {
      "type": "string",
      "enum": [
        "line",
        "bar",
        "area",
        "donut"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "string",
                  "maxLength": 40
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          }
        },
        "required": [
          "name",
          "points"
        ],
        "additionalProperties": false
      },
      "maxItems": 5
    },
    "y_label": {
      "type": "string",
      "maxLength": 60
    }
  },
  "required": [
    "kind",
    "chart",
    "series"
  ],
  "additionalProperties": false
}
