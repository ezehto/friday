{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/blocks/meter.schema.json",
  "title": "MeterBlock",
  "type": "object",
  "properties": {
    "kind": {
      "const": "meter"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "done": {
            "type": "number",
            "minimum": 0
          },
          "total": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tone": {
            "$ref": "../common.schema.json#/$defs/Tone"
          }
        },
        "required": [
          "label",
          "done",
          "total"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    }
  },
  "required": [
    "kind",
    "items"
  ],
  "additionalProperties": false
}
