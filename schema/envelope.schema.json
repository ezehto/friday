{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.invalid/schema/envelope.schema.json",
  "title": "WidgetEnvelope",
  "type": "object",
  "properties": {
    "widget_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,40}$"
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "data_class": {
      "$ref": "common.schema.json#/$defs/DataClass"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "blocks/block.schema.json"
      }
    }
  },
  "required": [
    "widget_id",
    "source",
    "as_of",
    "data_class",
    "title",
    "blocks"
  ],
  "additionalProperties": false
}
